[Unit]
Description=Subtitle Remover V1
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/subtitle-remover
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/subtitle-remover/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 9091
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
